# Copy to .env (never commit .env) and fill in from your Supabase project:
# Dashboard -> Project Settings -> API.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
# SERVICE_ROLE key: ONLY for Edge Function secrets, NEVER in the frontend:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY="..."
#   (supabase functions deploy sets SUPABASE_URL / ANON / SERVICE_ROLE
#    automatically for deployed functions; this is only needed for local
#    `supabase functions serve`.)
SUPABASE_SERVICE_ROLE_KEY=
# Staff session signing secret (generate one per project, keep it secret):
#   supabase secrets set STAFF_SESSION_SECRET="$(openssl rand -hex 32)"
STAFF_SESSION_SECRET=
